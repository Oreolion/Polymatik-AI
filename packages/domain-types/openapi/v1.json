  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "service", "version"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          },
          "service": {
            "type": "string",
            "enum": ["polymatik-api"]
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Me": {
        "type": "object",
        "additionalProperties": false,
        "required": ["user_id"],
        "properties": {
          "user_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "ApiError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message", "request_id", "retryable"],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "request_id": {
                "type": "string",
                "format": "uuid"
              },
              "retryable": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "PreviewResource": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "source",
          "publisher",
          "kind",
          "topic",
          "url",
          "description",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$",
            "maxLength": 48
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "publisher": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "type": "string",
            "enum": ["Chapter", "Interactive", "Article", "Course"]
          },
          "topic": {
            "type": "string",
            "enum": ["Physics", "Mathematics", "Computing"]
          },
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "description": "Fixed reviewed original HTTPS URL from the preview catalog."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "ResourceList": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "$ref": "#/components/schemas/PreviewResource"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "responses": {
      "NotFound": {
        "description": "Unknown route.",
        "headers": {
          "X-Request-Id": {
            "description": "Server-generated correlation ID.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      }
    }
  }
}
