{
  "name": "polymatik-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.2",
  "engines": {
    "node": ">=24.3.0 <25"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0 && prettier --check . \"!**/{.cache,.pnpm-store,.venv,.pytest_cache,.ruff_cache,.mypy_cache,__pycache__,.next,.expo,.wrangler,.vinext,dist,build,coverage,playwright-report,test-results}/**\"",
    "format": "prettier --write . \"!**/{.cache,.pnpm-store,.venv,.pytest_cache,.ruff_cache,.mypy_cache,__pycache__,.next,.expo,.wrangler,.vinext,dist,build,coverage,playwright-report,test-results}/**\"",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "node --test tests/foundation/*.test.mjs tests/contracts/web-stream.test.mjs tests/contracts/discover.test.mjs tests/contracts/discovery-preview.test.mjs tests/contracts/web-config.test.mjs tests/contracts/ui-tokens.test.mjs tests/contracts/mobile-config.test.mjs tests/contracts/mobile-toolchain.test.mjs tests/contracts/api.test.mjs tests/contracts/api-client.test.mjs tests/contracts/resource-detail.test.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "preview:web": "pnpm --filter web preview",
    "test:web": "node --test tests/contracts/web-runtime.test.mjs",
    "test:web:unit": "node --test tests/contracts/web-stream.test.mjs tests/contracts/discover.test.mjs tests/contracts/resource-detail.test.mjs",
    "dev:mobile": "pnpm --filter mobile start",
    "test:mobile": "pnpm --filter mobile test",
    "build:mobile:check": "pnpm --filter mobile export:check",
    "generate:api": "node scripts/generate-api.mjs",
    "check:api": "node scripts/generate-api.mjs --check",
    "test:api": "node --test tests/contracts/api.test.mjs tests/contracts/api-client.test.mjs",
    "test:api:runtime": "node --test tests/contracts/api-runtime.test.mjs",
    "dev:api": "pnpm --filter api dev",
    "build:api:check": "pnpm --filter api build:check"
  },
  "pnpm": {
    "overrides": {
      "debug": "4.4.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "9.30.0",
    "@types/node": "22.15.30",
    "eslint": "9.30.0",
    "globals": "14.0.0",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "openapi-typescript": "7.13.0"
  }
}
