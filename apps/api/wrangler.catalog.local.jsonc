{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Development simulation only. The launcher always supplies --local.
  "name": "polymatik-api-catalog-development",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "dev": { "ip": "127.0.0.1", "port": 8789 },
  "vars": {
    "ALLOWED_ORIGINS": "http://127.0.0.1:8788,http://localhost:8788",
    "CATALOG_BACKEND": "postgres",
  },
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000" },
  ],
}
