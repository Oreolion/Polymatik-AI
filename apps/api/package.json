{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "dev": "wrangler dev --local --env local",
    "types:worker": "wrangler types src/worker-env.d.ts --config wrangler.jsonc",
    "build:check": "wrangler deploy --dry-run --env local --outdir ../../.cache/api-worker"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "wrangler": "4.152.0"
  },
  "dependencies": {
    "@polymatik/domain-types": "workspace:*",
    "better-auth": "1.7.14",
    "pg": "8.16.3"
  }
}
