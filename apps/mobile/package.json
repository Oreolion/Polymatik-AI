{
  "name": "mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go --lan",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest --runInBand",
    "export:check": "expo export --platform ios --platform android --max-workers 2 --output-dir ../../.cache/mobile-export"
  },
  "dependencies": {
    "@babel/runtime": "7.29.10",
    "@polymatik/ui-tokens": "workspace:*",
    "expo": "58.0.16",
    "expo-constants": "58.0.13",
    "expo-linking": "58.0.13",
    "expo-router": "58.0.24",
    "expo-status-bar": "58.0.3",
    "expo-symbols": "58.0.4",
    "expo-system-ui": "58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-worklets": "0.13.0",
    "@polymatik/api-client": "workspace:*",
    "@polymatik/domain-types": "workspace:*",
    "@expo/dom-webview": "58.0.2",
    "@expo/metro-runtime": "58.0.15",
    "react-server-dom-webpack": "19.3.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@testing-library/react-native": "14.0.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-preset-expo": "58.0.18",
    "jest": "30.4.2",
    "jest-expo": "58.0.11",
    "typescript": "6.0.3",
    "test-renderer": "1.3.0"
  },
  "jest": {
    "preset": "jest-expo/ios",
    "testMatch": [
      "<rootDir>/tests/**/*.test.tsx"
    ],
    "cacheDirectory": "../../.cache/jest-mobile"
  }
}
