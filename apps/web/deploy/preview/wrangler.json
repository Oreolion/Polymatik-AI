{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "account_id": "70124db50dbd9c76cfc1d69d7972ac32",
  "name": "polymatik-web-preview",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "services": [
    { "binding": "PRODUCT_API", "service": "polymatik-api-preview" }
  ],
  "assets": {
    "directory": "../../../../.cache/cloudflare-preview/web/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "vars": {
    "PRODUCT_API_ORIGIN": "https://polymatik-api-preview.remyoreo11.workers.dev",
    "AUTH_PUBLIC_ORIGIN": "https://polymatik-web-preview.remyoreo11.workers.dev",
    "NEON_AUTH_BASE_URL": "https://ep-muddy-lab-za9hvwfl.neonauth.c-2.eu-west-2.aws.neon.tech/neondb/auth",
    "PRODUCT_CATALOG_VERSION": "v2"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
